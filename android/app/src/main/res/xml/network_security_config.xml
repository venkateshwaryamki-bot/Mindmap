<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed so the app can reach a MindFlow server on your home Wi-Fi. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
