# Copy to .env and fill in. Never commit .env.

# Claude API key for the in-app assistant (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium          # low | medium | high | xhigh | max
# CLAUDE_FALLBACKS=on           # set to "off" if your gateway rejects the server-side fallback beta
# PORT=8787
# MINDFLOW_DATA_DIR=./data/maps
