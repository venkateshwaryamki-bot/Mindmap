# Copy to .env and fill in. Never commit .env.

# Claude API key for the in-app assistant (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Password for the web app. Set this before putting MindFlow on the internet.
# Each device stays signed in for 180 days.
APP_PASSWORD=

# Token MCP clients send as "Authorization: Bearer <token>" (defaults to APP_PASSWORD)
# MCP_TOKEN=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium          # low | medium | high | xhigh | max
# CLAUDE_FALLBACKS=on           # set to "off" if your gateway rejects the server-side fallback beta
# PORT=8787
# HOST=0.0.0.0                 # 127.0.0.1 = only this computer can connect
# MINDFLOW_DATA_DIR=./data/maps
